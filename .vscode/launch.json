{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug tasker tests (utee-runner)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/_bin/utee-runner",
      "args": [
        "${command:cmake.buildDirectory}/_bin/libtasker.tests.dylib"
      ],
      "cwd": "${command:cmake.buildDirectory}/_bin",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "lldb"
    }
  ]
}
